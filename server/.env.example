# Copy to .env on the VPS — never commit .env

POSTGRES_USER=feedtime
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=feedtime

# For local `npm start` without Docker Compose network:
# DATABASE_URL=postgres://feedtime:change-me-strong-db-password@127.0.0.1:5432/feedtime

JWT_SECRET=change-me-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# * = allow any origin (OK for WebView + personal VPS). Or comma-list of origins.
CORS_ORIGIN=*

# Host port mapping for API (default loopback — put Caddy/nginx in front)
API_BIND=127.0.0.1:3080

# For Let's Encrypt via Caddy profile:
# DOMAIN=feed.example.com
# Then: docker compose --profile tls up -d
DOMAIN=

PORT=3080
HOST=0.0.0.0
